{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "swrpg-the-emperors-expendables-dashboard",
  "compatibility_date": "2026-07-30",
  "main": "worker/index.js",
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "swrpg-the-emperors-expendables-dashboard",
  "compatibility_date": "2026-07-30",
  "main": "worker/index.js",
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // Shared dice-roller log (see worker/index.js /rolls route + the RollLog
  // class). Runs as a Durable Object rather than the previous shared KV
  // namespace, so writes are serialized (no more lost rolls from two people
  // posting at once) and reads are strongly consistent (no more up-to-a-
  // minute lag). new_sqlite_classes provisions it on the SQLite storage
  // backend, which is available on the Workers Free plan.
  "durable_objects": {
    "bindings": [
      { "name": "ROLL_LOG", "class_name": "RollLog" },
      { "name": "NOTES_LOG", "class_name": "NotesLog" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RollLog"] },
    { "tag": "v2", "new_sqlite_classes": ["NotesLog"] }
  ]
}
